# ---------- LLM 双模式 ----------
# mock: 确定性假模型,离线可跑、单测稳定(默认)
# openai: OpenAI 兼容端点,如 DeepSeek
LLM_MODE=mock
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=deepseek-chat

# ---------- Embedding 双模式 ----------
EMBED_MODE=mock
EMBED_DIM=1024
EMBED_MODEL=text-embedding-3-small

# ---------- 研发数据来源 ----------
# snapshot: 内置快照,离线可复现(默认)
# github:   真实 GitHub REST。**必须同时配置 GITHUB_TOKEN 与 GITHUB_REPO**,
#           否则后端不装载任何数据(界面显示空数据),而**不会**用快照顶替。
DATA_SOURCE=snapshot
GITHUB_TOKEN=
# github 模式的目标仓库,形如 owner/name
GITHUB_REPO=
GITHUB_API_BASE=https://api.github.com

# ---------- 权限 ----------
# 形如 member:tok1,maintainer:tok2。留空 = 演示模式(无认证,角色由前端选择);
# /api/auth/mode 会如实报告 enforced=false,界面也会显示提示。
DEVFLOW_ROLE_TOKENS=

# ---------- Agent 执行约束 ----------
CONTEXT_BUDGET=8000
MAX_AGENT_STEPS=8
MAX_REPLAN=2
WORKFLOW_PARALLELISM=4